<h1>lightweight_charts_rails demo</h1>
<p>
  Declarative Line + Histogram series (via <code>lightweight_chart_tag</code>), rendered by
  <code>LightweightChartController</code>. Volume is in its own pane, with a couple of markers on the price series.
</p>
<%= lightweight_chart_tag(
      id: "demo-chart",
      style: "height: 320px; border: 1px solid #ddd",
      fit_content: true,
      options: { layout: { background: { color: "#ffffff" } } },
      series: [
        {
          type: "Line",
          name: "price",
          options: { color: "#2563eb", lineWidth: 2 },
          data: @line,
          markers: [
            { time: @line[10][:time], position: "aboveBar", color: "#2563eb", shape: "arrowDown", text: "high" },
            { time: @line[40][:time], position: "belowBar", color: "#2563eb", shape: "arrowUp", text: "low" }
          ]
        },
        {
          type: "Histogram",
          name: "volume",
          pane: 1,
          options: { priceFormat: { type: "volume" } },
          data: @volume
        }
      ]
    ) %>
